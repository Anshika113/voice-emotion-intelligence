# ============================================================
#  Voice Emotion Detection — environment configuration
#  Copy this file to `.env` and fill in your keys.
# ============================================================

# ---- Speech-to-text: Sarvam AI (Indian-language ASR) ----
# Get a free key at https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key_here
SARVAM_MODEL=saarika:v2.5       # v2.5 supports Hinglish / code-mixing
SARVAM_LANGUAGE=hi-IN           # or "unknown" to auto-detect the language

# For non-English speech: translate -> English and use the accurate English emotion
# model (recommended). Set false to use the multilingual sentiment model directly.
EMOTION_USE_TRANSLATION=true

# Use Sarvam-M (LLM) for context-aware emotion (best accuracy on nuanced sentences).
# Uses your Sarvam key; falls back to the local model on failure. Set false to disable.
EMOTION_LLM=true
EMOTION_LLM_MODEL=sarvam-105b-conversations   # fast, returns clean replies (free-tier friendly)

# ---- Bot reply (optional) ----
# Leave blank to use the free, built-in emotion/language-aware templates.
# Add an Anthropic key (https://console.anthropic.com) for smart LLM replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Text-to-speech: edge-tts (free, no key needed) ----
TTS_VOICE_HINDI=hi-IN-SwaraNeural
TTS_VOICE_ENGLISH=en-US-AriaNeural

# ---- Twilio (ONLY for real phone calls; not needed for the mic script) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Server / networking ----
# PUBLIC_HOST is your ngrok / cloudflare domain (no scheme) — only for phone calls.
PUBLIC_HOST=your-tunnel-domain.trycloudflare.com
HOST=127.0.0.1
PORT=8123

# ---- Feature toggles ----
ENABLE_AUDIO_EMOTION=true       # wav2vec2 tone analysis (language-agnostic)
ENABLE_BOT_REPLY=true           # generate + (on phone calls) speak a reply
